# Deep Research Agent - Environment Variables Template
# Copy this file to research_agent/.env and fill in your API keys

# =============================================================================
# LLM PROVIDERS (Required: At least one)
# =============================================================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# SEARCH PROVIDERS (Required: At least one)
# =============================================================================

# Exa API Key (Recommended for best content quality)
# Get from: https://exa.ai/
EXA_API_KEY=...

# Tavily API Key (Good for news and real-time info)
# Get from: https://tavily.com/
TAVILY_API_KEY=...

# Firecrawl API Key (Good for web scraping)
# Get from: https://firecrawl.dev/
FIRECRAWL_API_KEY=...

# Parallel AI API Key (Advanced AI-powered search)
# Get from: https://parallel.ai/
PARALLEL_API_KEY=...

# =============================================================================
# MEMORY STORAGE (Optional)
# =============================================================================

# Supermemory API Key
# Get from: https://supermemory.ai/
SUPERMEMORY_API_KEY=...

# Supermemory Base URL (default: https://api.supermemory.ai)
SUPERMEMORY_BASE_URL=https://api.supermemory.ai

# =============================================================================
# CODE EXECUTION (Optional)
# =============================================================================

# Daytona API Key (for sandboxed code execution)
# Get from: https://daytona.io/
DAYTONA_API_KEY=...

# =============================================================================
# SPECIALIZED TOOL API KEYS (Optional)
# =============================================================================

# xAI API Key (for X/Twitter search via Grok)
# Get from: https://x.ai/
XAI_API_KEY=...

# OpenWeatherMap API Key (for weather data)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=...

# AviationStack API Key (for flight tracking)
# Get from: https://aviationstack.com/
AVIATIONSTACK_API_KEY=...

# Alpha Vantage API Key (for stock market data)
# Get from: https://www.alphavantage.co/
ALPHAVANTAGE_API_KEY=...

# CoinGecko API Key (for cryptocurrency data)
# Get from: https://www.coingecko.com/en/api
COINGECKO_API_KEY=...

# Google Maps API Key (for geocoding and location services)
# Get from: https://developers.google.com/maps
GOOGLE_MAPS_API_KEY=...

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Search Provider Selection
# Options: exa, tavily, firecrawl, parallel
# Default: exa
SEARCH_PROVIDER=exa

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO

# Maximum Research Tasks
# Maximum number of tasks in a research plan
# Default: 15, Range: 1-20
MAX_RESEARCH_TASKS=15

# Maximum Tool Calls
# Maximum number of tool executions per research session
# Default: 15, Range: 1-30
MAX_TOOL_CALLS=15

# Maximum Search Results
# Maximum number of results per search query
# Default: 8, Range: 1-20
MAX_SEARCH_RESULTS=8

# Content Maximum Characters
# Maximum characters to keep from each source
# Default: 3000, Range: 100-10000
CONTENT_MAX_CHARS=3000

# Enabled Tools
# Comma-separated list of tools to enable
# Default: web_search,code_executor,memory_search
# Available tools:
#   - web_search: General web search (requires search provider API key)
#   - code_executor: Python code execution (requires DAYTONA_API_KEY)
#   - memory_search: Search stored research memories (requires SUPERMEMORY_API_KEY)
#   - x_search: X/Twitter search (requires XAI_API_KEY)
#   - youtube_search: YouTube video search with transcripts (requires EXA_API_KEY)
#   - reddit_search: Reddit content search (requires TAVILY_API_KEY)
#   - academic_search: Academic paper search (requires EXA_API_KEY)
#   - convert_currency: Currency conversion (no API key required)
#   - datetime_operations: Date/time utilities (no API key required)
#   - get_weather: Weather data (requires OPENWEATHER_API_KEY)
#   - track_flight: Flight tracking (requires AVIATIONSTACK_API_KEY)
#   - get_stock_data: Stock market data (requires ALPHAVANTAGE_API_KEY)
#   - get_crypto_data: Cryptocurrency data (requires COINGECKO_API_KEY)
#   - get_crypto_market_overview: Crypto market overview (requires COINGECKO_API_KEY)
#   - geocode_location: Address to coordinates (requires GOOGLE_MAPS_API_KEY)
#   - reverse_geocode: Coordinates to address (requires GOOGLE_MAPS_API_KEY)
#   - calculate_distance: Distance calculation (requires GOOGLE_MAPS_API_KEY)
ENABLED_TOOLS=web_search,code_executor,memory_search

# =============================================================================
# NOTES
# =============================================================================

# 1. At least one LLM API key (OpenAI or Anthropic) is required
# 2. At least one Search Provider API key is required
# 3. Memory storage (Supermemory) is optional but recommended
# 4. Code execution (Daytona) is optional
# 5. All configuration values have sensible defaults
# 6. For production, use strong API keys and secure storage
# 7. Never commit this file with real API keys to version control
